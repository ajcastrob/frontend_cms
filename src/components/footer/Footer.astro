---
const year = new Date().getFullYear();
---

<footer class="border-t border-base-300">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-8 sm:flex-row sm:items-end sm:justify-between sm:px-6 sm:py-10"
  >
    <aside class="flex flex-col gap-2">
      <p class="font-display text-lg font-bold leading-none">Ashi Labs</p>
      <p class="max-w-sm text-sm text-base-content/70">
        Apuntes sobre skills de IA, probadas y anotadas.
      </p>
    </aside>
    <div class="flex flex-col gap-3 sm:items-end">
      <nav class="flex gap-4" aria-label="Pie de página">
        <a href="/" class="link link-hover">Inicio</a>
        <a href="/skills/" class="link link-hover">Skills</a>
      </nav>
      <p class="text-sm text-base-content/70">© {year} jacastro</p>
    </div>
  </div>
</footer>
