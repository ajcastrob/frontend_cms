---
const path = Astro.url.pathname;
const isHome = path === "/";
const isSkills = path.startsWith("/skills");
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100">
  <div
    class="navbar mx-auto min-h-16 w-full max-w-5xl justify-between gap-3 px-4 sm:gap-6 sm:px-6"
  >
    <a
      href="/"
      class="inline-flex min-w-0 items-center gap-2 py-1"
      aria-label="Ashi Labs, portada"
    >
      <svg class="h-7 w-7 shrink-0 text-base-content" aria-hidden="true">
        <use href="/assets/icons/logo.svg#logo"></use>
      </svg>
      <span class="font-display truncate text-xl font-bold leading-none sm:text-2xl">
        Ashi Labs
      </span>
    </a>
    <nav class="shrink-0" aria-label="Navegación principal">
      <ul class="flex items-center gap-3 sm:gap-5">
        <li>
          <a
            href="/"
            aria-current={isHome ? "page" : undefined}
            class="inline-block whitespace-nowrap py-2 text-sm font-medium text-base-content decoration-primary/50 underline-offset-8 transition-colors duration-150 ease-out hover:text-primary sm:text-base aria-[current=page]:text-primary aria-[current=page]:underline"
          >
            Inicio
          </a>
        </li>
        <li>
          <a
            href="/skills/"
            aria-current={isSkills ? "page" : undefined}
            class="inline-block whitespace-nowrap py-2 text-sm font-medium text-base-content decoration-primary/50 underline-offset-8 transition-colors duration-150 ease-out hover:text-primary sm:text-base aria-[current=page]:text-primary aria-[current=page]:underline"
          >
            Skills
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
