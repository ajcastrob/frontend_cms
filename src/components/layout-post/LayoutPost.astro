---
import Cover from "@/components/cover/Cover.astro";
import PostMeta from "@/components/post-meta/PostMeta.astro";
import { imageUrl } from "@/lib/wagtail.js";

const { posts = [] } = Astro.props;

const latest = posts.slice(0, 3);
const [featured, ...rest] = latest;
---

{
  latest.length === 0 ? (
    <section class="mt-12 sm:mt-16" aria-labelledby="ultimas-skills">
      <h2 id="ultimas-skills" class="font-sans text-2xl font-bold sm:text-3xl">
        Últimas skills
      </h2>
      <p class="mt-6 text-base-content/70">Aún no hay skills publicadas.</p>
    </section>
  ) : (
    <section class="mt-12 sm:mt-16" aria-labelledby="ultimas-skills">
      <h2 id="ultimas-skills" class="font-sans text-2xl font-bold sm:text-3xl">
        Últimas skills
      </h2>

      {featured && (
        <article class="mt-8 flex flex-col gap-6 sm:mt-10 lg:flex-row lg:items-center lg:gap-10">
          <div class="min-w-0 lg:max-w-xl">
            <h3 class="font-sans text-2xl font-semibold leading-snug text-balance sm:text-3xl">
              <a
                href={`/skills/${featured.meta.slug}`}
                class="text-base-content decoration-primary/40 underline-offset-4 transition-colors duration-150 ease-out hover:text-primary hover:underline"
              >
                {featured.title}
              </a>
            </h3>
            <p class="mt-3 max-w-prose text-base leading-relaxed text-base-content/70">
              {featured.intro}
            </p>
            <div class="mt-4">
              <PostMeta date={featured.date} tags={featured.tags} />
            </div>
          </div>
          {featured.image && (
            <Cover
              src={imageUrl(featured.image)}
              alt={featured.caption || featured.image.title || ""}
              class="aspect-[16/10] w-full rounded-box object-cover lg:w-[26rem] lg:shrink-0"
              loading="eager"
              sizes="(min-width: 1024px) 26rem, 100vw"
            />
          )}
        </article>
      )}

      {rest.length > 0 && (
        <ul class="mt-10 divide-y divide-base-300 border-t border-base-300">
          {rest.map((post) => (
            <li>
              <article class="flex items-start gap-4 py-8 sm:gap-6">
                {post.image && (
                  <Cover
                    src={imageUrl(post.image)}
                    alt={post.caption || post.image.title || ""}
                    class="size-20 shrink-0 rounded-box object-cover sm:size-24"
                    sizes="6rem"
                  />
                )}
                <div class="min-w-0">
                  <h3 class="font-sans text-lg font-semibold leading-snug text-balance sm:text-xl">
                    <a
                      href={`/skills/${post.meta.slug}`}
                      class="text-base-content decoration-primary/40 underline-offset-4 transition-colors duration-150 ease-out hover:text-primary hover:underline"
                    >
                      {post.title}
                    </a>
                  </h3>
                  <p class="mt-2 max-w-prose text-base leading-relaxed text-base-content/70">
                    {post.intro}
                  </p>
                  <div class="mt-3">
                    <PostMeta date={post.date} tags={post.tags} />
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
