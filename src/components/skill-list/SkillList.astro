---
import Cover from "@/components/cover/Cover.astro";
import PostMeta from "@/components/post-meta/PostMeta.astro";
import { imageUrl } from "@/lib/wagtail.js";

const { posts = [] } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="mt-8 text-base-content/70">Aún no hay skills publicadas.</p>
  ) : (
    <ul class="mt-8 divide-y divide-base-300 border-t border-base-300 sm:mt-10">
      {posts.map((post) => (
        <li>
          <article class="flex flex-col gap-4 py-8 sm:flex-row sm:items-start sm:gap-6">
            {post.image && (
              <Cover
                src={imageUrl(post.image)}
                alt={post.caption || post.image.title || ""}
                class="aspect-[16/10] w-full rounded-box object-cover sm:aspect-square sm:w-36 sm:shrink-0"
                sizes="(min-width: 640px) 9rem, 100vw"
              />
            )}
            <div class="min-w-0">
              <h2 class="font-sans text-xl font-semibold leading-snug text-balance sm:text-2xl">
                <a
                  href={`/skills/${post.meta.slug}`}
                  class="text-base-content decoration-primary/40 underline-offset-4 transition-colors duration-150 ease-out hover:text-primary hover:underline"
                >
                  {post.title}
                </a>
              </h2>
              <p class="mt-2 max-w-prose text-base leading-relaxed text-base-content/70">
                {post.intro}
              </p>
              <div class="mt-3">
                <PostMeta date={post.date} tags={post.tags} />
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  )
}
