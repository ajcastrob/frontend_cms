---
import "@fontsource/kalam/400.css";
import "@fontsource/kalam/700.css";
import "@fontsource-variable/figtree";
import "../assets/app.css";
import Header from "@/components/header/Header.astro";
import Footer from "@/components/footer/Footer.astro";

const { title = "Skills" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-[100dvh] flex-col bg-base-100 font-sans text-base-content">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-field focus:border focus:border-base-300 focus:bg-base-200 focus:px-4 focus:py-2 focus:text-base-content"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
