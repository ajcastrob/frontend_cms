---
import Layout from "@/layouts/Layout.astro";
import Cover from "@/components/cover/Cover.astro";
import PostMeta from "@/components/post-meta/PostMeta.astro";
import { getBlogPost, imageUrl } from "@/lib/wagtail.js";

export async function getStaticPaths() {
  const posts = await getBlogPost();

  return posts.map((post) => ({
    params: { slug: post.meta.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const cover = imageUrl(post.image);
---

<Layout title={post.title}>
  <article class="max-w-[42rem]">
    <nav class="breadcrumbs py-0 text-sm text-base-content/70" aria-label="Migas de pan">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/skills/">Skills</a></li>
      </ul>
    </nav>

    <header class="mt-8 sm:mt-10">
      <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl sm:leading-[1.15]">
        {post.title}
      </h1>
      {post.intro && (
        <p class="mt-5 text-lg leading-relaxed text-base-content/70 sm:text-xl">
          {post.intro}
        </p>
      )}
      <div class="mt-6 border-t border-base-300 pt-4">
        <PostMeta date={post.date} tags={post.tags} />
      </div>
    </header>

    {cover && (
      <figure class="mt-8 sm:mt-10">
        <Cover
          src={cover}
          alt={post.caption || post.image.title || ""}
          class="aspect-[16/10] w-full rounded-box object-cover"
          loading="eager"
          sizes="(min-width: 42rem) 42rem, 100vw"
        />
        {post.caption && (
          <figcaption class="mt-3 text-sm leading-relaxed text-base-content/70">
            {post.caption}
          </figcaption>
        )}
      </figure>
    )}

    {post.body && <div class="article-body mt-8" set:html={post.body} />}

    {post.repo_url && (
      <p class="mt-12 border-t border-base-300 pt-6">
        <a
          href={post.repo_url}
          class="link"
          rel="noopener noreferrer"
          target="_blank"
        >
          Ver repositorio
        </a>
      </p>
    )}
  </article>
</Layout>
