---
import { getBlogPost } from "@/lib/wagtail.js";
import Layout from "@/layouts/Layout.astro";
import SkillList from "@/components/skill-list/SkillList.astro";

const posts = await getBlogPost();
---

<Layout title="Skills">
  <h1 class="font-sans text-3xl font-bold text-balance sm:text-4xl">Skills</h1>
  <p class="mt-3 max-w-[42ch] text-base leading-relaxed text-base-content/70 sm:text-lg">
    El catálogo completo: cada nota cuenta qué hace una skill y si vale la pena probarla.
  </p>
  <SkillList posts={posts} />
</Layout>
